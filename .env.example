# Copy to .env for local development. Never commit real values.

# Agent model. The framework picks OpenAI when this is set.
OPENAI_API_KEY=

# Database. Leave unset locally to use the built-in PGlite database.
# Production (Supabase): DATABASE_URL = transaction pooler (port 6543),
# DATABASE_MIGRATION_URL = session pooler (port 5432, release migrations only).
# DATABASE_URL=
# DATABASE_MIGRATION_URL=

# Telegram bot for staff (see docs/ROADMAP.md, "Telegram setup").
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# APP_URL=
# A2A_SECRET=

# Production database tuning (see docs/ROADMAP.md, "Framework patch").
# DB_OP_TIMEOUT_MS=4000
# DB_IDLE_RECYCLE_MS=3600000

# Auth: standalone production deploys need a stable BETTER_AUTH_SECRET.
# BETTER_AUTH_SECRET=

# Bind the dev server to IPv4 if IPv6 isn't available.
# DEV_HOST=127.0.0.1
